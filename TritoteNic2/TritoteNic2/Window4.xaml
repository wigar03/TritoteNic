<Window x:Class="TritoteNic2.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Pedido"
        WindowStartupLocation="CenterScreen"
        Width="520" Height="750"
        Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">
            <StackPanel>

                <!-- TÍTULO -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Nuevo Pedido"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#333"/>

                    <TextBlock Text="Paso 2: Elegir productos del catálogo"
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="#888"/>
                </StackPanel>


                <!-- LISTA DE PRODUCTOS -->
                <WrapPanel ItemWidth="150" ItemHeight="260" Margin="0,0,0,20">


                    <!-- PRODUCTO 1 -->
                    <Border Background="White" CornerRadius="10" Padding="10" Width="150" Height="260" Margin="5">
                        <StackPanel>

                            <!-- CUADRO GRIS EN VEZ DE IMAGEN -->
                            <Border Background="#D3D3D3"
                                    Height="100"
                                    Margin="0,0,0,10"
                                    CornerRadius="5"/>

                            <TextBlock Text="Totebag con diseño"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="C$250"
                                       Margin="0,3,0,0"
                                       FontSize="13"/>

                            <Border Background="#EEE" CornerRadius="5"
                                    Padding="5,2" Margin="0,5,0,0">
                                <TextBlock Text="Stock: 15"
                                           FontSize="11"
                                           Foreground="#555"/>
                            </Border>

                            <Button Content="Agregar"
                                    Margin="0,10,0,0"
                                    Background="#D6BB6B"
                                    Foreground="White"
                                    BorderBrush="#C9A855"
                                    Padding="5"/>
                        </StackPanel>
                    </Border>



                    <!-- PRODUCTO 2 -->
                    <Border Background="White" CornerRadius="10" Padding="10" Width="150" Height="260" Margin="5">
                        <StackPanel>

                            <Border Background="#D3D3D3"
                                    Height="100"
                                    Margin="0,0,0,10"
                                    CornerRadius="5"/>

                            <TextBlock Text="Totebag sencilla"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="C$150"
                                       Margin="0,3,0,0"
                                       FontSize="13"/>

                            <Border Background="#EEE" CornerRadius="5"
                                    Padding="5,2" Margin="0,5,0,0">
                                <TextBlock Text="Stock: 22"
                                           FontSize="11"
                                           Foreground="#555"/>
                            </Border>

                            <Button Content="Agregar"
                                    Margin="0,10,0,0"
                                    Background="#D6BB6B"
                                    Foreground="White"
                                    BorderBrush="#C9A855"
                                    Padding="5"/>
                        </StackPanel>
                    </Border>


                    <!-- Puedes duplicar más productos aquí -->


                </WrapPanel>



                <!-- CARRITO -->
                <Border Background="#FAFAFA"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>

                        <TextBlock Text="🛒  Carrito (1 producto)"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,10" />

                        <Border Background="White" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Totebag sencilla" FontWeight="Bold"/>
                                    <TextBlock Text="C$150 × 1"
                                               Foreground="#777"
                                               FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                    <Button Content="–"
                                            Width="30" Height="28"
                                            Background="#EEE"
                                            BorderBrush="#CCC"
                                            Margin="0,0,5,0"/>

                                    <TextBlock Text="1"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Margin="0,0,5,0"/>

                                    <Button Content="+"
                                            Width="30" Height="28"
                                            Background="#EEE"
                                            BorderBrush="#CCC"/>
                                </StackPanel>

                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>



                <!-- BOTONES FINALES -->
                <Grid Margin="0,10,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Content="Atrás"
                            Grid.Column="0"
                            Padding="15,8"
                            Background="#EAEAEA"
                            BorderBrush="#D0D0D0"
                            Margin="0,0,10,0"/>

                    <Button Content="Siguiente"
                            Grid.Column="1"
                            Padding="15,8"
                            Background="#D6BB6B"
                            Foreground="White"
                            BorderBrush="#C9A855"/>
                </Grid>

            </StackPanel>
        </Grid>

    </ScrollViewer>

</Window>
