<Window x:Class="TritoteNic2.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del Pedido"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        Width="520" Height="650">

    <Grid Margin="20">
        <Border CornerRadius="10" Background="White" Padding="20">
            <StackPanel>

                <!-- ENCABEZADO -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Pedido #001"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#333" />
                        <TextBlock Text="Detalles completos del pedido"
                                   Margin="0,2,0,0"
                                   Foreground="#777"
                                   FontSize="12" />
                    </StackPanel>

                    <!-- ESTADO -->
                    <Border Grid.Column="1"
                            Background="#FFF4C2"
                            CornerRadius="10"
                            Padding="10,3"
                            Margin="0,0,0,5">
                        <TextBlock Text="Pendiente"
                                   Foreground="#C89A00"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Border>
                </Grid>

                <!-- INFORMACION DEL CLIENTE -->
                <Border Margin="0,20,0,10" Background="#FAFAFA" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Información del Cliente"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"
                                   Foreground="#333"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nombre" Foreground="#777" FontSize="12"/>
                                <TextBlock Text="Elias Matuz" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Fecha del Pedido" Foreground="#777" FontSize="12"/>
                                <TextBlock Text="2025-10-06" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Método de Pago" Foreground="#777" FontSize="12"/>
                                <TextBlock Text="Transferencia" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total" Foreground="#777" FontSize="12"/>
                                <TextBlock Text="$8,500" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PRODUCTOS -->
                <Border Margin="0,0,0,20" Background="#FAFAFA" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Productos"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <!-- PRODUCTO 1 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Bolso Clásico Negro"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="Cantidad: 2"
                                           Foreground="#777"
                                           FontSize="12"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="$17,000"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Separator/>

                        <!-- PRODUCTO 2 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Cartera Mini Rosa"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock Text="Cantidad: 1"
                                           Foreground="#777"
                                           FontSize="12"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="$4,500"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- BOTONES -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Editar Estado"
                            Padding="15,8"
                            Background="#EAEAEA"
                            Foreground="#333"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,10,0"/>

                    <Button Content="Descargar PDF"
                            Padding="15,8"
                            Background="#D6BB6B"
                            Foreground="White"
                            BorderBrush="#C9A855"
                            BorderThickness="1"
                            Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
