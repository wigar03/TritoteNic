<Window x:Class="TritoteNic2.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nuevo Pedido"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#80000000"
        Height="450" Width="800">

    <Grid>

        <!-- Contenedor del Modal -->
        <Border Background="White"
                CornerRadius="12"
                Width="500"
                Padding="25"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                >

            <StackPanel>

                <!-- TÍTULO -->
                <TextBlock Text="Nuevo Pedido"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0 0 0 5"/>

                <!-- SUBTÍTULO -->
                <TextBlock Text="Paso 1: Seleccionar cliente y método de pago"
                           Foreground="#666"
                           FontSize="14"
                           Margin="0 0 0 20"/>

                <!-- CLIENTE -->
                <TextBlock Text="Cliente" 
                           FontWeight="SemiBold" 
                           Margin="0 0 0 5"/>

                <Grid Margin="0 0 0 15">
                    <TextBox Name="ClienteTextBox"
                             Padding="8"
                             FontSize="14"/>

                    <!-- Watermark -->
                    <TextBlock Text="Nombre del cliente"
                               Foreground="#999"
                               Margin="10 0 0 0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ClienteTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- MÉTODO DE PAGO -->
                <TextBlock Text="Método de Pago" 
                           FontWeight="SemiBold"
                           Margin="0 0 0 5"/>

                <Grid Margin="0 0 0 25">
                    <ComboBox Name="MetodoPagoCombo"
                              Padding="8"
                              FontSize="14">
                        <ComboBoxItem Content="Efectivo"/>
                        <ComboBoxItem Content="Transferencia"/>
                        <ComboBoxItem Content="Tarjeta"/>
                    </ComboBox>

                    <!-- Watermark -->
                    <TextBlock Text="Seleccionar método"
                               Foreground="#999"
                               Margin="10 0 0 0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=MetodoPagoCombo}" Value="-1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- BOTÓN SIGUIENTE -->
                <Button Content="Siguiente"
                        Width="120"
                        Height="38"
                        HorizontalAlignment="Right"
                        Background="#E3D2A1"
                        Foreground="#444"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsEnabled="False">
                </Button>

            </StackPanel>

        </Border>

    </Grid>

</Window>
