<Window x:Class="ClientesApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes"
        WindowStartupLocation="CenterScreen"
        Height="900" Width="1600"
        Background="#F5F6FA">

    <Window.Resources>
        <!-- Estilo del botón del menú lateral -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="10,5"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFEFEF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main -->
        </Grid.ColumnDefinitions>

        <!-- ▬▬▬▬▬▬▬▬▬▬▬▬▬▬ LEFT SIDEBAR ▬▬▬▬▬▬▬▬▬▬▬▬▬▬ -->
        <Border Background="White" CornerRadius="12" Padding="20" Margin="0 0 20 0">
            <StackPanel>
                <TextBlock Text="Tritote Nicaragua" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Sistema de Gestión"
                           Margin="0,4,0,20"
                           Foreground="#777"/>

                <Separator Margin="0,10"/>

                <Button Content="Dashboard" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="Pedidos" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="Productos" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="Clientes" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="Reportes" Style="{StaticResource MenuButtonStyle}"/>
                <Button Content="Usuarios" Style="{StaticResource MenuButtonStyle}"/>

                <StackPanel Margin="0,150,0,0">
                    <Separator/>
                    <TextBlock Text="Alfredo Montalván" FontSize="14" Margin="0,10,0,0"/>
                    <TextBlock Text="Administrador" FontSize="12" Foreground="#777"/>
                    <Button Content="Cerrar sesión"
                            Margin="0,20,0,0"
                            Background="#EEE"
                            BorderThickness="0"
                            Padding="8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ▬▬▬▬▬▬▬▬▬▬▬▬▬▬ MAIN CONTENT ▬▬▬▬▬▬▬▬▬▬▬▬▬▬ -->
        <StackPanel Grid.Column="1" Margin="0,0,-21,0">

            <!-- TITULO -->
            <TextBlock Text="Clientes"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Text="Gestiona tu base de clientes"
                       Foreground="#777"
                       Margin="0,0,0,25"/>

            <!-- TARJETAS SUPERIORES -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta 1 -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock Text="Total Clientes" FontSize="14" Foreground="#777" Margin="0,0,0,6"/>
                        <TextBlock Text="6" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2 -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock Text="Clientes VIP" FontSize="14" Foreground="#777" Margin="0,0,0,6"/>
                        <TextBlock Text="2" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3 -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Valor Promedio" FontSize="14" Foreground="#777" Margin="0,0,0,6"/>
                        <TextBlock Text="$113,350" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BARRA DE BÚSQUEDA -->
            <DockPanel Margin="0,0,0,20">
                <TextBox Width="450" Height="38"
                         Padding="10"
                         Background="White"
                         BorderBrush="#DDD"
                         FontSize="14"
                         Text="Buscar clientes..." />
            </DockPanel>

            <!-- TABLA CLIENTES -->
            <Border Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Lista de Clientes"
                               FontWeight="Bold"
                               FontSize="18"
                               Margin="0,0,0,10"/>

                    <ListView Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nombre" Width="200"/>
                                <GridViewColumn Header="Email" Width="220"/>
                                <GridViewColumn Header="Teléfono" Width="150"/>
                                <GridViewColumn Header="Pedidos" Width="80"/>
                                <GridViewColumn Header="Total Gastado" Width="150"/>
                                <GridViewColumn Header="Categoría" Width="120"/>
                                <GridViewColumn Header="Último Pedido" Width="150"/>
                                <GridViewColumn Header="Acciones" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                </Grid>
            </Border>
        </StackPanel>

    </Grid>

</Window>
