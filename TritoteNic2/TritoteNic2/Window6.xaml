<Window x:Class="TritoteNic2.Window6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window6" Height="720" Width="1280" Background="#F5F5F5">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main content -->
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             SIDEBAR IZQUIERDO
        ============================================================ -->
        <Border Background="#FFFFFF" Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="15">

                <TextBlock Text="Tritote Nicaragua"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,20"/>

                <!-- Opciones -->
                <Button Content="Dashboard"
                        Height="35"
                        Margin="0,5,0,0"
                        HorizontalContentAlignment="Left"
                        Padding="10"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#444"/>

                <Button Content="Pedidos"
                        Height="35"
                        Margin="0,5,0,0"
                        HorizontalContentAlignment="Left"
                        Padding="10"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#444"/>

                <Button Content="Productos"
                        Height="35"
                        Margin="0,5,0,0"
                        HorizontalContentAlignment="Left"
                        Padding="10"
                        Background="#EEE"
                        BorderThickness="0"
                        Foreground="#444"/>

                <Button Content="Clientes"
                        Height="35"
                        Margin="0,5,0,0"
                        HorizontalContentAlignment="Left"
                        Padding="10"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#444"/>

                <Button Content="Reportes"
                        Height="35"
                        Margin="0,5,0,0"
                        HorizontalContentAlignment="Left"
                        Padding="10"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#444"/>

                <Button Content="Usuarios"
                        Height="35"
                        Margin="0,5,0,0"
                        HorizontalContentAlignment="Left"
                        Padding="10"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#444"/>

            </StackPanel>
        </Border>

        <!-- ============================================================
             CONTENIDO PRINCIPAL
        ============================================================ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- =====================================================
                     BARRA SUPERIOR (Título + Nuevo Producto)
                ====================================================== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Catálogo de Productos"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Gestiona el inventario de bolsos"
                                   FontSize="12"
                                   Foreground="#777"/>
                    </StackPanel>

                    <!-- Botón NUEVO PRODUCTO a la derecha -->
                    <Button Grid.Column="1"
                            Content="+ Nuevo Producto"
                            Width="130"
                            Height="30"
                            Margin="0,0,0,0"
                            Background="#E8CEA0"
                            BorderBrush="#D0B887"
                            Foreground="White"/>
                </Grid>

                <!-- =====================================================
                     BUSCADOR CON PLACEHOLDER REAL
                ====================================================== -->
                <Grid Grid.Row="1" Width="300" Height="28" Margin="0,20,0,20">
                    <TextBox x:Name="SearchBox"
                             Background="White"
                             BorderBrush="#DDD"
                             BorderThickness="1"
                             Padding="6,2,6,2"
                             VerticalContentAlignment="Center"/>

                    <!-- Placeholder -->
                    <TextBlock Text="Buscar productos..."
                               Foreground="#999"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- =====================================================
                     TARJETAS DE PRODUCTOS (solo primera fila)
                ====================================================== -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== TARJETA 1 ===== -->
                    <Border Grid.Column="0" Background="White" CornerRadius="6"
                            BorderBrush="#EEE" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel Margin="10">

                            <Border Background="#DDD" Height="260" CornerRadius="6"/>

                            <TextBlock Text="Bolso Clásico Negro" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Bolsos" FontSize="12" Foreground="#777"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="$8,500" FontWeight="Bold"/>
                                <TextBlock Text="Stock: 15"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"
                                           Foreground="#777"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Editar" Width="80" Height="26"
                                        Background="#F5F5F5" BorderBrush="#CCC"/>
                                <Button Content="Eliminar" Width="80" Height="26"
                                        Margin="10,0,0,0"
                                        Background="#FDECEC" BorderBrush="#E5A5A5"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ===== TARJETA 2 ===== -->
                    <Border Grid.Column="1" Background="White" CornerRadius="6"
                            BorderBrush="#EEE" BorderThickness="1" Margin="10,0">
                        <StackPanel Margin="10">

                            <Border Background="#DDD" Height="260" CornerRadius="6"/>

                            <TextBlock Text="Cartera Mini Rosa" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Carteras" FontSize="12" Foreground="#777"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="$4,500" FontWeight="Bold"/>
                                <TextBlock Text="Stock: 22"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"
                                           Foreground="#777"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Editar" Width="80" Height="26"
                                        Background="#F5F5F5" BorderBrush="#CCC"/>
                                <Button Content="Eliminar" Width="80" Height="26"
                                        Margin="10,0,0,0"
                                        Background="#FDECEC" BorderBrush="#E5A5A5"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ===== TARJETA 3 ===== -->
                    <Border Grid.Column="2" Background="White" CornerRadius="6"
                            BorderBrush="#EEE" BorderThickness="1" Margin="10,0">
                        <StackPanel Margin="10">

                            <Border Background="#DDD" Height="260" CornerRadius="6"/>

                            <TextBlock Text="Tote Bag Beige" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Bolsos" FontSize="12" Foreground="#777"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="$6,700" FontWeight="Bold"/>
                                <TextBlock Text="Stock: 8"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"
                                           Foreground="#777"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Editar" Width="80" Height="26"
                                        Background="#F5F5F5" BorderBrush="#CCC"/>
                                <Button Content="Eliminar" Width="80" Height="26"
                                        Margin="10,0,0,0"
                                        Background="#FDECEC" BorderBrush="#E5A5A5"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ===== TARJETA 4 ===== -->
                    <Border Grid.Column="3" Background="White" CornerRadius="6"
                            BorderBrush="#EEE" BorderThickness="1" Margin="10,0,0,0">
                        <StackPanel Margin="10">

                            <Border Background="#DDD" Height="260" CornerRadius="6"/>

                            <TextBlock Text="Clutch Dorado" FontWeight="Bold" Margin="0,8,0,0"/>
                            <TextBlock Text="Clutches" FontSize="12" Foreground="#777"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="$5,300" FontWeight="Bold"/>
                                <TextBlock Text="Stock: 18"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"
                                           Foreground="#777"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Editar" Width="80" Height="26"
                                        Background="#F5F5F5" BorderBrush="#CCC"/>
                                <Button Content="Eliminar" Width="80" Height="26"
                                        Margin="10,0,0,0"
                                        Background="#FDECEC" BorderBrush="#E5A5A5"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </Grid>

            </Grid>
        </ScrollViewer>

    </Grid>

</Window>
