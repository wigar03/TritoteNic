<Window x:Class="TritoteNic_test.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TritoteNic_test"
        mc:Ignorable="d"
        Title="TritoteNic Dashboard" Height="800" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Grid Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10" VerticalAlignment="Top">
                <TextBlock Text="Dashboard" Foreground="White" FontWeight="Bold" Margin="0,20,0,10"/>
                <TextBlock Text="Productos" Foreground="White" Margin="0,10"/>
                <TextBlock Text="Pedidos" Foreground="White" Margin="0,10"/>
                <TextBlock Text="Clientes" Foreground="White" Margin="0,10"/>
                <TextBlock Text="Reportes" Foreground="White" Margin="0,10"/>
                <TextBlock Text="Usuarios" Foreground="White" Margin="0,10"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Margin="10">
                <TextBlock Text="Laura González" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="Administrador" Foreground="White"/>
                <Button Content="Cerrar Sesión" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Contenido principal -->
        <Grid Grid.Column="1" Margin="10,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="fecha fecha fecha" FontWeight="Bold" FontSize="14"/>
            </StackPanel>

            <!-- Indicadores -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,20">
                <Border Background="#ECF0F1" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Ventas del Día" FontWeight="Bold"/>
                        <TextBlock Text="$8,945" FontSize="16"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECF0F1" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Ventas de la Semana" FontWeight="Bold"/>
                        <TextBlock Text="$48,300 ↑ 4.2%" FontSize="16"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECF0F1" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Ventas del Mes" FontWeight="Bold"/>
                        <TextBlock Text="$125,400 ↑ 6.4%" FontSize="16"/>
                    </StackPanel>
                </Border>
                <Border Background="#ECF0F1" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Pedidos Activos" FontWeight="Bold"/>
                        <TextBlock Text="32 ↑ 10.2%" FontSize="16"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Gráficas -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Gráfica 1: Ingresos diarios -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Ingresos diarios en pesos" FontWeight="Bold" Margin="10"/>
                        <Canvas Height="200" Background="#F8F8F8"/>
                    </StackPanel>
                </Border>

                <!-- Gráfica 2: Top 5 del mes -->
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Top 5 del mes" FontWeight="Bold" Margin="10"/>
                        <Canvas Height="200" Background="#F8F8F8"/>
                    </StackPanel>
                </Border>

                <!-- Gráfica 3: Distribución por categoría -->
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Distribución por Categoría" FontWeight="Bold" Margin="10"/>
                        <Canvas Height="200" Background="#F8F8F8"/>
                    </StackPanel>
                </Border>

                <!-- Gráfica 4: Tendencia mensual -->
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Tendencia Mensual" FontWeight="Bold" Margin="10"/>
                        <Canvas Height="200" Background="#F8F8F8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
