<Window x:Class="TritoteNic_test.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TritoteNic_test"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10" VerticalAlignment="Top">
                <TextBlock Text="Dashboard" Foreground="White" FontWeight="Bold" Margin="0,20,0,10"/>
                <TextBlock Text="Pedidos" Foreground="White" Margin="0,10"/>
                <TextBlock Text="Productos" Foreground="White" Margin="0,10"/>
                <TextBlock Text="Clientes" Foreground="White" Margin="0,10"/>
                <TextBlock Text="Reportes" Foreground="White" Margin="0,10"/>
                <TextBlock Text="Usuarios" Foreground="White" Margin="0,10"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Margin="10">
                <TextBlock Text="Lenna González" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="Gerente General" Foreground="White"/>
                <Button Content="Cerrar Sesión" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Contenido principal con scroll -->
        <ScrollViewer Grid.Column="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Encabezado -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                    <TextBlock Text="Sábado, 28 de noviembre de 2025" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
                <TextBlock Text="Reportes y Análisis" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Comparativa de Ventas -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Análisis detallado de tendencias de ventas" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Comparativa de Ventas" FontWeight="Bold" Margin="10,10,0,5"/>
                        <!-- Gráfico de barras comparativas -->
                        <Canvas Height="250" Background="#F8F8F8"/>
                        <!-- Filtros y exportación -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <ComboBox Width="120" Margin="0,0,10,0">
                                <ComboBoxItem Content="Por mes" IsSelected="True"/>
                            </ComboBox>
                            <Button Content="Exportar Excel" Margin="0,0,10,0"/>
                            <Button Content="Exportar PDF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rotación de productos -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mayor Rotación -->
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Mayor Rotación" FontWeight="Bold" FontSize="16"/>
                            <ListBox>
                                <ListBoxItem Content="Bolsa Clásica Negra - 145 unidades"/>
                                <ListBoxItem Content="Carteras Mini Rosa - 126 unidades"/>
                                <ListBoxItem Content="Tote Bag Beige - 98 unidades"/>
                                <ListBoxItem Content="Mochila Urbana - 87 unidades"/>
                                <ListBoxItem Content="Clutch Dorado - 84 unidades"/>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Menor Rotación -->
                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Menor Rotación" FontWeight="Bold" FontSize="16"/>
                            <ListBox>
                                <ListBoxItem Content="Bolsa XXL - 8 unidades"/>
                                <ListBoxItem Content="Clutch Rojo - 8 unidades"/>
                                <ListBoxItem Content="Clutch Vintage - 6 unidades"/>
                                <ListBoxItem Content="Carteras Vintage - 4 unidades"/>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tendencias de color -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Tendencias de Color" FontWeight="Bold" FontSize="16"/>
                        <ListBox>
                            <ListBoxItem Content="Negro - 180 unidades"/>
                            <ListBoxItem Content="Beige/Nude - 160 unidades"/>
                            <ListBoxItem Content="Rosa - 140 unidades"/>
                            <ListBoxItem Content="Dorado - 120 unidades"/>
                            <ListBoxItem Content="Rojo - 100 unidades"/>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Gráficos de color y temporada -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gráfico de colores -->
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Popularidad por Color" FontWeight="Bold" Margin="10"/>
                            <Canvas Height="200" Background="#F8F8F8"/>
                        </StackPanel>
                    </Border>

                    <!-- Gráfico de temporada -->
                    <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel>
                            <TextBlock Text="Tendencias por Temporada" FontWeight="Bold" Margin="10"/>
                            <Canvas Height="200" Background="#F8F8F8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
