<Window x:Class="UsuariosInteractivos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios"
        Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Título -->
            <TextBlock Text="Gestión de Usuarios" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Administra usuarios y permisos del sistema" FontSize="14" Foreground="Gray" Margin="0,0,0,20"/>

            <!-- Formulario de ingreso -->
            <GroupBox Header="Nuevo Usuario" FontWeight="Bold" Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Nombre:" Width="100" VerticalAlignment="Center"/>
                        <TextBox Name="txtNombre" Width="300"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Email:" Width="100" VerticalAlignment="Center"/>
                        <TextBox Name="txtEmail" Width="300"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Rol:" Width="100" VerticalAlignment="Center"/>
                        <ComboBox Name="cmbRol" Width="300">
                            <ComboBoxItem Content="Administrador"/>
                            <ComboBoxItem Content="Vendedor"/>
                            <ComboBoxItem Content="Analista"/>
                            <ComboBoxItem Content="Usuario"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Estado:" Width="100" VerticalAlignment="Center"/>
                        <ComboBox Name="cmbEstado" Width="300">
                            <ComboBoxItem Content="Activo"/>
                            <ComboBoxItem Content="Inactivo"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="Agregar Usuario"
                            Width="150" Height="35"
                            Background="#007ACC" Foreground="White"
                            FontWeight="Bold" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <!-- Tabla de usuarios -->
            <GroupBox Header="Usuarios del Sistema" FontWeight="Bold">
                <DataGrid Name="dgUsuarios"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Margin="10"
                          Height="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                        <DataGridTemplateColumn Header="Acciones" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏️" Width="30" Margin="2"/>
                                        <Button Content="🗑️" Width="30" Margin="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
